{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Nudge": "Data Source=nudge.db"
  },
  "Jwt": {
    "Issuer": "nudge-api",
    "Audience": "nudge-app",
    "Key": "",
    "ExpiryHours": 168
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "NudgesPerMinute": 30
  }
}